@startuml
left to right direction
skinparam packageStyle rectangle

' --- ACTORS ---
actor "Customer\n(Mobile App)" as Customer
actor "System Admin\n(Web Admin)" as Admin

' --- PACKAGE ACCOUNT ---
package "Account Management" {
    usecase "Login via Mobile App" as UC_LoginMobile
    usecase "Login via Web Admin" as UC_LoginWeb
    
    usecase "Register" as UC_Register
    usecase "Manage Profile" as UC_Profile
    usecase "Logout" as UC_Logout
}


' --- CUSTOMER ASSOCIATIONS ---
Customer -- UC_LoginMobile
Customer -- UC_Register
Customer -- UC_Profile
Customer -- UC_Logout

' --- ADMIN ASSOCIATIONS ---
Admin -- UC_LoginWeb
Admin -- UC_Profile
Admin -- UC_Logout

@enduml